<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WolHeartbeat.MainWindow"
        Title="WOL 心跳客户端"
        Width="820" Height="760"
        MinWidth="700" MinHeight="620"
        Background="{StaticResource PageBrush}"
        Icon="/Assets/app.ico">

  <Grid Margin="22,20,22,16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- 标题与状态 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="WOL 心跳客户端"
                   FontSize="21" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="目标机定时向服务端报到，不需要开放任何入站端口"
                   FontSize="12" Margin="0,4,0,0"
                   Foreground="{StaticResource MutedBrush}" />
      </StackPanel>

      <Border Grid.Column="1" VerticalAlignment="Center"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
              CornerRadius="18" Padding="14,7">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="StatusDot" Width="9" Height="9"
                   Fill="{StaticResource IdleBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="未启动" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 配置卡片 -->
    <Border Grid.Row="1" Margin="0,18,0,0"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="18">
      <StackPanel Spacing="14">

        <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,16,Auto">

          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Classes="label" Text="服务器地址" />
            <TextBox x:Name="ServerBox" PlaceholderText="http://192.168.1.10:8080" />
            <TextBlock Classes="hint" Text="NAS 上服务的地址，含端口。" />
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Classes="label" Text="心跳密钥" />
            <TextBox x:Name="SecretBox" PlaceholderText="16 位以上，与网页里该设备一致" />
            <TextBlock Classes="hint" Text="网页里编辑设备 → 校验方式「心跳上报」→ 复制密钥。" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Classes="label" Text="本机 MAC" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox x:Name="MacBox" Grid.Column="0" PlaceholderText="AA:BB:CC:DD:EE:FF" />
              <Button x:Name="DetectMacButton" Grid.Column="2" Content="自动识别"
                      Click="OnDetectMac" Padding="12,8" />
            </Grid>
            <TextBlock Classes="hint" Text="必须与网页里那台设备的 MAC 完全一致，否则上报会被拒绝。" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="label" Text="上报间隔（秒）" />
            <NumericUpDown x:Name="IntervalBox" Minimum="15" Maximum="600"
                           Increment="15" FormatString="0" Value="60" />
            <TextBlock Classes="hint" Text="默认 60 秒；服务端给出的建议间隔会覆盖此项。" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock x:Name="LastReportText" Text="最近上报：—"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="NextDueText" Text="下次上报：—"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="ErrorText" Text="" IsVisible="False"
                     FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource ErrBrush}" />
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- 操作按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
      <Button x:Name="StartButton" Classes="accent" Content="保存并开始上报" Click="OnStart" />
      <Button x:Name="StopButton" Content="停止" Click="OnStop" IsEnabled="False" />
      <Button x:Name="SendOnceButton" Content="立即上报一次" Click="OnSendOnce" />
      <Button x:Name="OpenLogButton" Content="打开日志目录" Click="OnOpenLog" />
    </StackPanel>

    <!-- 选项与日志标题 -->
    <Grid Grid.Row="3" Margin="2,14,2,8" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <CheckBox x:Name="StartOnLaunchCheck" Content="启动程序即开始上报" FontSize="12" />
        <CheckBox x:Name="RunAtLogonCheck" Content="登录 Windows 时自动启动" FontSize="12"
                  Click="OnRunAtLogonChanged" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="运行日志" VerticalAlignment="Center"
                 FontSize="12" Foreground="{StaticResource MutedBrush}" />
    </Grid>

    <!-- 日志 -->
    <Border Grid.Row="4"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="2">
      <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas, Cascadia Mono, Menlo, monospace" FontSize="12"
               Background="Transparent" BorderThickness="0" Padding="10" />
    </Border>

    <!-- 页脚 -->
    <Grid Grid.Row="5" Margin="2,10,2,0" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="LogPathText" Text="日志：—" FontSize="11"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" />
      <TextBlock Grid.Column="1" Text="v1.1.1" FontSize="11"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>

  </Grid>
</Window>
