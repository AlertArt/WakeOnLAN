# 复制为 .env 后再启动：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交，也不要写进镜像。

# 登录口令（必填）。容器直接占用宿主端口，没有反向代理兜底，
# 这是唯一的一道门：建议 16 位以上随机串，例如 `openssl rand -base64 24`。
WOL_ADMIN_PASSWORD=change-me-to-a-long-random-string

# 宿主监听端口。host 网络下容器直接使用宿主端口，冲突时改这里。
WOL_PORT=8080

# 登录令牌有效期，Go duration 格式（168h = 7 天）。
WOL_TOKEN_TTL=168h

# 日志级别：debug / info / warn / error
WOL_LOG_LEVEL=info
