# 复制为 .env 后再启动：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交，也不要写进镜像。

# 登录口令（必填）。容器直接占用宿主端口，没有反向代理兜底，
# 这是唯一的一道门：建议 16 位以上随机串，例如 `openssl rand -base64 24`。
WOL_ADMIN_PASSWORD=change-me-to-a-long-random-string

# 宿主监听端口。host 网络下容器直接使用宿主端口，冲突时改这里。
WOL_PORT=8080

# 登录令牌有效期，Go duration 格式（168h = 7 天）。
WOL_TOKEN_TTL=168h

# 日志级别：debug / info / warn / error
WOL_LOG_LEVEL=info

# ---------- 远程桌面（F11-M2，可选） ----------
# 启用步骤：
#   1) 生成密钥：openssl rand -hex 16      → 32 位十六进制
#   2) 填好下面三项
#   3) docker compose -f docker-compose.nas.yml --profile rdp up -d
#
# wold 与 Guacamole 的共享密钥（必填才启用远程桌面）。
# 只需配这一处：Guacamole 容器启动时会把它写进自己的 guacamole.properties。
WOL_GUAC_SECRET=

# 浏览器访问 Guacamole 的地址——**必须是从手机/外网也能打开的地址**。
# 例：http://192.168.1.5:8088/guacamole
# 走 NAS 反代 + HTTPS 时填反代后的地址，例如 https://wol.example.com/guacamole
WOL_GUAC_URL=

# Guacamole 在宿主机上占用的端口（compose 里映射 8088→容器 8080）。
WOL_GUAC_PORT=8088

# 目标机 RDP 端口，改过远程桌面端口时同步这里。
WOL_RDP_PORT=3389
